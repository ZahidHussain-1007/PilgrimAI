# ── Supabase (Auth, Database & Storage) — REQUIRED ──────────────────────────
# Dashboard → Project Settings → API. All three values are needed before the
# app renders (empty values → the "sign-in is not configured" state).
# Also run supabase/schema.sql once in the SQL Editor (see README step 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: not used by app code today (server uses the user session + RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── Multiagent AI backend (server-side only) ────────────────────────────────
# Backend setup lives in multiagent/.env (GROQ_API_KEY_1, REDIS_HOST, ...).
# Start it: cd multiagent && python -m uvicorn app.main:app --reload --port 8000
MULTIAGENT_API_URL=http://127.0.0.1:8000

# ── Optional AI fallbacks (see src/services/ai/ai.service.ts) ───────────────
# MULTIAGENT_ENABLE_FALLBACK=true   # canned replies, never calls the backend
# MULTIAGENT_FALLBACK_ON_ERROR=true # canned replies only when backend fails
